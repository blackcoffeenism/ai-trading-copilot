# ====================================================================
# AI TRADING COPILOT SYSTEM CONFIGURATION TEMPLATE
# Copy this file to '.env' and adjust values for your environment.
# ====================================================================

# 1. FastAPI Settings
PROJECT_NAME="AI Trading Copilot"
API_V1_STR="/api/v1"

# 2. Database Connection
# PostgreSQL Database URL connecting to Supabase or local container
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# 3. Supabase Auth Security
# The JWT secret used by Supabase Auth (used to verify bearer tokens in endpoints)
SUPABASE_JWT_SECRET="super-secret-supabase-jwt-token-key-must-be-long-and-secure"

# 4. Analytical & AI Services endpoints
# Mapped in docker network or local dev ports
AI_SERVICE_URL="http://localhost:8001"
FORECAST_SERVICE_URL="http://localhost:8002"
